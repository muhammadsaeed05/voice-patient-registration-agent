# Environment Configuration for Voice AI Agent Patient Registration System

# Application Server
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database Configuration
# Local Development: sqlite:///data/patients.db
# Railway / Production (with persisted volume mounted at /app/data):
DATABASE_URL=sqlite:////app/data/patients.db

# Railway Public Domain (used for webhook registration in Vapi)
RAILWAY_URL=https://your-service-production.up.railway.app

# Vapi Telephony & Voice Agent Integration
# Get your API keys at: https://dashboard.vapi.ai/
VAPI_API_KEY=your_vapi_private_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER=your_vapi_phone_number_here

# LLM Provider Keys (configured in Vapi dashboard for OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
